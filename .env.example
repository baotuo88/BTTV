# ==================== 应用配置 ====================
ADMIN_PASSWORD=
ALLOW_REGISTER=true
STORAGE_DRIVER=local
LOCAL_DATA_DIR=./data
MONGODB_URI=
MONGODB_DB_NAME=
NEXT_PUBLIC_DOUBAN_API_URL=
SITE_NAME=
SITE_TITLE=
SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
PROXY_SIGN_SECRET=
PROXY_ALLOWED_HOSTS=

# ==================== 邮件服务（可选，用于找回密码） ====================
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ==================== 弹幕 API 配置 ====================
# 未同时配置 URL 和 TOKEN 时，弹幕功能自动禁用（不会打到第三方公共服务）
NEXT_PUBLIC_DANMU_API_URL=
NEXT_PUBLIC_DANMU_API_TOKEN=

# ==================== Google Analytics（可选） ====================
NEXT_PUBLIC_GA_ID=

# ==================== Dailymotion GraphQL（可选） ====================
# 仅在需要 GraphQL 回退时配置；未配置时会跳过 GraphQL 请求
DAILYMOTION_CLIENT_ID=
DAILYMOTION_CLIENT_SECRET=
